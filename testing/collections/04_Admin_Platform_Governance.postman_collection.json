    {
      "name": "TC-ADM-05: Test Platform 10% Revenue Aggregation [MOCK LOGIC]",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var trips = [",
              "    { id: 'REQ-3', fare: 3000000, commission: 300000 },",
              "    { id: 'REQ-2', fare: 1500000, commission: 150000 },",
              "    { id: 'REQ-1', fare: 2200000, commission: 220000 }",
              "];",
              "var totalGrossVolume = trips.reduce((acc, t) => acc + t.fare, 0); // 6,700,000",
              "var totalPlatformRevenue = trips.reduce((acc, t) => acc + t.commission, 0); // 670,000",
              "pm.test('Platform 10% revenue equals sum of individual trip commissions', function () {",
              "    pm.expect(totalGrossVolume).to.eql(6700000);",
              "    pm.expect(totalPlatformRevenue).to.eql(670000);",
              "    pm.expect(totalPlatformRevenue / totalGrossVolume).to.eql(0.10);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://httpbin.org/get?test=platform_revenue",
          "protocol": "https",
          "host": ["httpbin", "org"],
          "path": ["get"],
          "query": [{ "key": "test", "value": "platform_revenue" }]
        }
      }
    }
  ]
